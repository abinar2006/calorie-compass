# ==============================================================================
# CALORIE COMPASS — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Duplicate this file to '.env.local' and populate with your own credentials.
# The app works out-of-the-box in local evaluation mode if credentials are empty.
# ==============================================================================

# 1. SUPABASE AUTHENTICATION & POSTGRESQL (Required for persistent multi-user cloud DB)
# Sign up free at: https://supabase.com
# Find these in Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. FOODBASE API (Primary food-image recognition candidate)
# Sign up at: https://foodbase.dev
# Free tier provides developer quota for meal photo recognition
FOODBASE_API_KEY=your_foodbase_api_key_here

# 3. GOOGLE GEMINI API (Multimodal AI Vision & Generative AI Recipe Engine)
# Sign up free at: https://aistudio.google.com
# Free tier supports Gemini 1.5 Flash / 2.0 Flash with vision and structured JSON output
GEMINI_API_KEY=your_gemini_api_key_here

# 4. USDA FOODDATA CENTRAL API (Whole food & clinical nutrition lookup)
# Get a free API key at: https://api.data.gov/signup/ (1000 requests/hour)
# Or leave blank to use the built-in 'DEMO_KEY' (30 requests/hour)
USDA_FDC_API_KEY=DEMO_KEY

# 5. OPEN FOOD FACTS
# Open Food Facts (world.openfoodfacts.org) does not require an API key and is free!
